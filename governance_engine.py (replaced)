import os
import json
import hashlib
import numpy as np
from datetime import datetime

class GovernanceEngine:
    def __init__(self):
        self.max_buy_price = 68000.0
        self.buy_cash_pct = 20.0
        self.min_sell_price = 62000.0
        self.sell_pct = 20.0
        self.buy_active = True
        self.sell_active = True
        self.cash = 80000.0
        self.btc_balance = 0.3077

    def update_limits(self, new_limits):
        previous_limits = {
            "max_buy_price": self.max_buy_price,
            "buy_cash_pct": self.buy_cash_pct,
            "min_sell_price": self.min_sell_price,
            "sell_pct": self.sell_pct,
            "buy_active": self.buy_active,
            "sell_active": self.sell_active
        }
        
        for key, value in new_limits.items():
            setattr(self, key, value)
            
        if previous_limits != new_limits:
            self._log_admin_update(previous_limits, new_limits)

    def _log_admin_update(self, prev_limits, new_limits):
        entry = {
            "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            "actor": "Administrator",
            "event_type": "ADMIN_PARAMETER_UPDATE",
            "payload": {
                "previous_limits": prev_limits,
                "new_limits": new_limits
            }
        }
        
        prev_hash = "0" * 64
        try:
            if os.path.exists("audit_chain.jsonl"):
                with open("audit_chain.jsonl", "r") as f:
                    lines = f.readlines()
                    if lines:
                        last_record = json.loads(lines[-1].strip())
                        prev_hash = last_record.get("current_hash", prev_hash)
        except Exception:
            pass
            
        entry["previous_hash"] = prev_hash
        block_string = json.dumps(entry, sort_keys=True)
        entry["current_hash"] = hashlib.sha256(block_string.encode()).hexdigest()
        
        with open("audit_chain.jsonl", "a") as f:
            f.write(json.dumps(entry) + "\n")

    def run_automated_strategy_tick(self, current_price):
        admissible = True
        reason = "Automated market telemetry nominal."
        
        if self.buy_active and current_price <= self.max_buy_price:
            cost = self.cash * (self.buy_cash_pct / 100.0)
            if cost > 1.0:
                self.cash -= cost
                self.btc_balance += cost / current_price
                self._log_trade_execution(current_price, cost, "AUTOMATED_BUY_EXECUTION")
                reason = f"Buy executed at ${current_price:,.2f} for cost ${cost:,.2f}"
            else:
                admissible = False
                reason = "Insufficient cash liquidity for buy limit percentage."
        else:
            admissible = False
            reason = "Price exceeds max buy limit or buy boundaries disabled."
            
        return {
            "admissible": admissible,
            "interceptor_reason": reason
        }

    def _log_trade_execution(self, price, cost, event_type):
        entry = {
            "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            "actor": "Agent",
            "event_type": event_type,
            "payload": {
                "price": price,
                "cost": cost
            }
        }
        
        prev_hash = "0" * 64
        try:
            if os.path.exists("audit_chain.jsonl"):
                with open("audit_chain.jsonl", "r") as f:
                    lines = f.readlines()
                    if lines:
                        last_record = json.loads(lines[-1].strip())
                        prev_hash = last_record.get("current_hash", prev_hash)
        except Exception:
            pass
            
        entry["previous_hash"] = prev_hash
        block_string = json.dumps(entry, sort_keys=True)
        entry["current_hash"] = hashlib.sha256(block_string.encode()).hexdigest()
        
        with open("audit_chain.jsonl", "a") as f:
            f.write(json.dumps(entry) + "\n")

    def rademacher_metric(self, price_history=None):
        if not price_history or len(price_history) < 3:
            return 0.3500
        prices = np.array(price_history)
        returns = np.diff(prices) / prices[:-1]
        n_samples = len(returns)
        rng = np.random.default_rng(seed=len(price_history))
        sigma = rng.choice([-1, 1], size=n_samples)
        empirical_rad = float(np.mean(sigma * returns))
        return round(float(np.clip(abs(empirical_rad) * 45.0 + 0.2, 0.05, 1.0)), 4)

    def dissipativity_metric(self, price_history=None):
        if not price_history or len(price_history) < 3:
            return 1.2500
        prices = np.array(price_history)
        returns = np.diff(prices) / prices[:-1]
        volatility = float(np.std(returns))
        dis = 0.8 + (volatility * 35.0)
        return round(float(np.clip(dis, 0.5, 2.0)), 4)

