def compute_live_volatility_metrics(price_history):
    prices = np.array(price_history)
    if len(prices) < 3:
        return 0.2500, 0.8500
    
    returns = np.diff(prices) / prices[:-1]
    volatility = float(np.std(returns)) if len(returns) > 0 else 0.01
    
    rad = round(min(1.0, 0.2 + (volatility * 25.0)), 4)
    dis = round(min(2.0, 0.8 + (volatility * 40.0)), 4)
    return rad, dis

def compute_stress_scenario_metrics(profile, horizon):
    base_rad, base_dis = 0.3500, 1.1000
    horizon_multiplier = {"1 Day": 1.0, "1 Week": 1.05, "1 Month": 1.15, "3 Months": 1.25}.get(horizon, 1.0)
    profile_mult = {"Nominal": 1.0, "High Volatility": 1.4, "Liquidity Crunch": 1.8}.get(profile, 1.0)
    
    rad = round(base_rad * horizon_multiplier * profile_mult, 4)
    dis = round(base_dis * horizon_multiplier * profile_mult, 4)
    return {"rademacher_estimate": min(rad, 1.0), "dissipativity_metric": min(dis, 2.0)}

