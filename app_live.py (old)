                if st.session_state.portfolio_btc >= btc_sold:
                    st.session_state.portfolio_btc -= btc_sold
                    st.session_state.portfolio_cash += btc_sold * current_price

            override_label = f"Admin Override {override_side}"
            override_reason = "Admin override executed successfully."

            st.session_state.order_history.append({
                "Timestamp": time.strftime("%Y-%m-%d %H:%M:%S"),
